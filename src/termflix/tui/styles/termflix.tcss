Screen {
    background: #080808;
    color: #e0e0e0;
    align: center middle;
}

/* ── Intro ─────────────────────────────────────────── */

#intro-spacer {
    height: 2;
}

#intro-logo {
    content-align: center middle;
    text-align: center;
    text-style: bold;
    width: 100%;
}

#intro-tagline {
    content-align: center middle;
    text-align: center;
    color: #555555;
    width: 100%;
    margin-top: 1;
}

#intro-hint {
    content-align: center middle;
    text-align: center;
    color: #333333;
    width: 100%;
    margin-top: 2;
}

/* ── Global ───────────────────────────────────────────────────────────────── */

Screen {
    background: #080808;
    color: #e0e0e0;
    align: center middle;
    border: double #222222;
    padding: 1 2;
}

/* ── Home ─────────────────────────────────────────────────────────────────── */

#home-title {
    text-align: center;
    content-align: center middle;
    color: #00ff99;
    text-style: bold;
    width: 100%;
    margin-bottom: 2;
}

#home-menu {
    width: 30;
    height: auto;
    background: transparent;
    border: none;
    margin: 0 1;
    align: center middle;
}

#home-menu > ListItem {
    background: transparent;
    color: #666666;
    padding: 0 2;
    height: 3;
    content-align: left middle;
}

#home-menu > ListItem.--highlight {
    background: #111111;
    color: #ffffff;
    border-left: tall #00ff99;
}

#home-menu > ListItem:disabled {
    color: #2a2a2a;
}

#home-footer {
    text-align: center;
    color: #2a2a2a;
    width: 100%;
    margin-top: 2;
}


/* ── Browse ───────────────────────────────────────────────────────────────── */

#browse-path {
    color: #00ff99;
    margin: 0 1;
}

#browse-count {
    color: #444444;
    margin: 0 1 1 1;
}

#browse-list {
    border: solid #1a1a1a;
    background: #0a0a0a;
    height: 1fr;
    margin: 0 1;
}

#browse-list > ListItem {
    background: transparent;
    padding: 0 2;
}

#browse-list > ListItem.--highlight {
    background: #0d1f17;
    border-left: solid #00ff99;
}

#browse-footer {
    text-align: center;
    color: #333333;
    margin-top: 1;
}