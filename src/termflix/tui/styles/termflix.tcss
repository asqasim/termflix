/* ── Global ───────────────────────────────────────────── */

Screen {
    background: #0a0a0a;
    color: #e0e0e0;
}

/* ── Intro ────────────────────────────────────────────── */

#intro-art {
    content-align: center middle;
    text-align: center;
    color: #00ff99;
    margin-top: 4;
}

#intro-tagline {
    content-align: center middle;
    text-align: center;
    color: #666666;
    margin-top: 1;
}

#intro-hint {
    content-align: center middle;
    text-align: center;
    color: #333333;
    margin-top: 2;
}

/* ── Home ─────────────────────────────────────────────── */

#home-title {
    content-align: center middle;
    text-align: center;
    color: #00ff99;
    text-style: bold;
    margin-top: 3;
    margin-bottom: 2;
}

#home-menu {
    width: 40;
    height: auto;
    margin: 1 2;
    border: solid #222222;
    background: #0f0f0f;
}

#home-menu > ListItem {
    padding: 1 3;
    color: #cccccc;
}

#home-menu > ListItem:hover {
    background: #1a1a1a;
    color: #00ff99;
}

#home-menu > ListItem.--highlight {
    background: #003322;
    color: #00ff99;
}

#home-hint {
    content-align: center middle;
    text-align: center;
    color: #555555;
    margin-top: 2;
}